# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------- data sources
# Semicolon-separated list: kind:location|Label|flags
#   kind  = xlsx          local .xlsx file (e.g. the file exported from the Google Sheet)
#           csv           folder with one CSV per tab, named exactly like the tab
#           gsheet        Google Sheets API with a service account (see below) - location = spreadsheet ID or URL
#           gsheet-public Google Sheet shared "Anyone with the link can view" - no credentials needed
# The first loadable source is shown by default.
# If DATA_SOURCES is not set, every .xlsx in ./data and ./data/fixtures is offered.
DATA_SOURCES="gsheet-public:<SPREADSHEET_ID>|Nyati Sales MIS"

# Cache for each source, in seconds (Refresh button clears it)
CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------- Google Sheets API (kind "gsheet")
# Create a service account in Google Cloud, enable the Google Sheets API, create a JSON key,
# and share the sheet with the service-account e-mail as Viewer. Then EITHER:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private key from the JSON file; keep the \n escapes, wrap in double quotes
GOOGLE_PRIVATE_KEY=
# OR point to the JSON key file (outside the repo):
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\nyati-dashboard-sa.json

# ---------------------------------------------------------------- login (STUB - replace with SSO)
# At least 16 random characters. Required in production.
AUTH_SECRET=
# email:password:Role;...   Roles: Admin | Sales Head | Viewer
# When empty in development, demo users are offered on the login page.
AUTH_USERS=

# ---------------------------------------------------------------- dashboard assistant (chatbot)
# Google Gemini API key (https://aistudio.google.com/apikey). Keep the real key in .env.local
# or in your host's secret settings - never in this file. Without a key the assistant still
# answers from the dashboard data using keyword matching.
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-3.8-flash) and questions per user per minute (default 20)
# GEMINI_MODEL=gemini-3.8-flash
# CHAT_RATE_LIMIT_PER_MINUTE=20
